<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="Admin.master.cs"
    Inherits="Success24v2.Admin" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1" />

    <title>Success24 - Admin Panel</title>


    <style>

        /* =========================================
           BASIC
        ========================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #1f2937;
        }


        /* =========================================
           SUCCESS24 STYLE NAVBAR
        ========================================= */

        .admin-navbar {
            width: 100%;
            height: 80px;

            display: flex;
            align-items: center;

            padding: 0 4.5%;

            background: #ffffff;

            border-bottom: 1px solid #eeeeee;

            box-shadow:
                0 3px 15px rgba(0, 0, 0, 0.06);

            position: sticky;
            top: 0;

            z-index: 1000;
        }


        /* =========================================
           LOGO
        ========================================= */

        .admin-logo {
            display: flex;
            align-items: center;

            text-decoration: none;

            margin-right: 65px;

            flex-shrink: 0;
        }


        .admin-logo img {
            width: 148px;
            max-height: 52px;

            object-fit: contain;

            display: block;
        }


        /* =========================================
           NAVIGATION
        ========================================= */

        .admin-nav {
            flex: 1;

            display: flex;
            align-items: center;

            gap: 12px;
        }


        .admin-nav a {
            position: relative;

            display: flex;
            align-items: center;

            height: 80px;

            padding: 0 18px;

            color: #111111;

            text-decoration: none;

            font-size: 15px;
            font-weight: 600;

            transition:
                color 0.2s ease,
                background 0.2s ease;
        }


        .admin-nav a:hover {
            color: #f65a18;
        }


        /* Orange underline */

        .admin-nav a::after {
            content: "";

            position: absolute;

            left: 18px;
            right: 18px;
            bottom: 19px;

            height: 2px;

            border-radius: 10px;

            background: #f65a18;

            transform: scaleX(0);

            transform-origin: center;

            transition: transform 0.25s ease;
        }


        .admin-nav a:hover::after {
            transform: scaleX(1);
        }


        /* =========================================
           USER MENU
        ========================================= */

        .user-menu {
            position: relative;

            margin-left: auto;
        }


        .user-button {
            display: flex;
            align-items: center;

            gap: 10px;

            min-height: 46px;

            padding: 6px 12px;

            border: none;

            background: transparent;

            color: #111111;

            border-radius: 8px;

            cursor: pointer;

            font-family: Arial, Helvetica, sans-serif;

            transition:
                background 0.2s ease,
                color 0.2s ease;
        }


        .user-button:hover {
            background: #fff7f2;

            color: #f65a18;
        }


        /* User initial circle */

        .user-avatar {
            width: 36px;
            height: 36px;

            display: flex;
            align-items: center;
            justify-content: center;

            flex-shrink: 0;

            border-radius: 50%;

            background: linear-gradient(
                135deg,
                #ff7417,
                #ef2f2f
            );

            color: #ffffff;

            font-size: 14px;
            font-weight: 700;
        }


        .user-details {
            display: flex;
            flex-direction: column;

            text-align: left;

            line-height: 1.2;
        }


        .nav-user-name {
            max-width: 130px;

            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;

            color: #111111;

            font-size: 14px;
            font-weight: 600;
        }


        .nav-user-role {
            margin-top: 3px;

            color: #777777;

            font-size: 10px;
            font-weight: 500;

            text-transform: uppercase;

            letter-spacing: 0.5px;
        }


        .dropdown-arrow {
            margin-left: 3px;

            color: #555555;

            font-size: 9px;
        }


        .user-button:hover .nav-user-name,
        .user-button:hover .dropdown-arrow {
            color: #f65a18;
        }


        /* =========================================
           DROPDOWN
        ========================================= */

        .dropdown-menu {
            display: none;

            position: absolute;

            top: calc(100% + 10px);
            right: 0;

            width: 220px;

            background: #ffffff;

            border: 1px solid #eeeeee;

            border-radius: 10px;

            box-shadow:
                0 12px 35px rgba(0, 0, 0, 0.14);

            overflow: hidden;

            z-index: 9999;
        }


        .dropdown-menu.show {
            display: block;

            animation: dropdownOpen 0.18s ease;
        }


        @keyframes dropdownOpen {

            from {
                opacity: 0;
                transform: translateY(-7px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


        /* Dropdown user */

        .dropdown-user {
            padding: 16px 17px;

            background: #fff8f4;

            border-bottom: 1px solid #eeeeee;
        }


        .dropdown-user-name {
            color: #111827;

            font-size: 14px;
            font-weight: 700;
        }


        .dropdown-role {
            margin-top: 4px;

            color: #f65a18;

            font-size: 11px;
            font-weight: 600;

            text-transform: uppercase;

            letter-spacing: 0.4px;
        }


        /* Dropdown links */

        .dropdown-menu a {
            display: block;

            padding: 13px 17px;

            color: #333333;

            text-decoration: none;

            font-size: 14px;
            font-weight: 500;

            transition:
                background 0.2s ease,
                color 0.2s ease;
        }


        .dropdown-menu a:hover {
            background: #fff7f2;

            color: #f65a18;
        }


        /* Logout */

        .logout-button {
            width: 100%;

            display: block;

            padding: 13px 17px;

            border: none;

            border-top: 1px solid #eeeeee;

            background: #ffffff;

            color: #dc2626;

            text-align: left;

            font-family: Arial, Helvetica, sans-serif;

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;

            transition: background 0.2s ease;
        }


        .logout-button:hover {
            background: #fff1f2;
        }


        /* =========================================
           PAGE CONTENT
        ========================================= */

        .admin-content {
            width: 100%;
            min-height: calc(100vh - 80px);
        }


        /* =========================================
           RESPONSIVE
        ========================================= */

        @media (max-width: 850px) {

            .admin-navbar {
                height: 68px;

                padding: 0 18px;
            }


            .admin-logo {
                margin-right: 20px;
            }


            .admin-logo img {
                width: 115px;
            }


            .admin-nav {
                gap: 0;
            }


            .admin-nav a {
                height: 68px;

                padding: 0 10px;

                font-size: 12px;
            }


            .admin-nav a::after {
                left: 10px;
                right: 10px;
                bottom: 14px;
            }


            .user-details {
                display: none;
            }


            .user-avatar {
                width: 34px;
                height: 34px;
            }


            .user-button {
                padding: 5px;
            }

        }


        @media (max-width: 550px) {

            .admin-navbar {
                padding: 0 10px;
            }


            .admin-logo {
                margin-right: 8px;
            }


            .admin-logo img {
                width: 95px;
            }


            .admin-nav a {
                padding: 0 6px;

                font-size: 11px;
            }


            .user-avatar {
                display: none;
            }


            .dropdown-arrow {
                font-size: 8px;
            }

        }

    </style>


    <!-- Child Page CSS -->

    <asp:ContentPlaceHolder
        ID="Head"
        runat="server">
    </asp:ContentPlaceHolder>


</head>


<body>


<form id="form1" runat="server">


    <!-- =========================================
         SUCCESS24 ADMIN NAVBAR
    ========================================== -->

    <nav class="admin-navbar">


        <!-- SUCCESS24 LOGO -->

        <asp:HyperLink
            ID="lnkLogo"
            runat="server"
            NavigateUrl="~/LeadManagement.aspx"
            CssClass="admin-logo">

            <asp:Image
                ID="imgLogo"
                runat="server"
                ImageUrl="~/img/logo.png"
                AlternateText="Success24" />

        </asp:HyperLink>



        <!-- =====================================
             NAVIGATION
        ====================================== -->

        <div class="admin-nav">


            <asp:HyperLink
                ID="lnkLeadManagement"
                runat="server"
                NavigateUrl="~/LeadManagement.aspx">

                Lead Management

            </asp:HyperLink>



            <asp:HyperLink
                ID="lnkMyLeads"
                runat="server"
                NavigateUrl="~/MyLeads.aspx">

                My Leads

            </asp:HyperLink>

             <asp:HyperLink
             ID="lnkAD"
             runat="server"
             NavigateUrl="~/AdminDashboard.aspx">

             Admin Dashboard

             </asp:HyperLink>

                <asp:HyperLink
                ID="lnkAG"
                runat="server"
                NavigateUrl="~/AdminGallery.aspx">

                Admin Gallery

                </asp:HyperLink>

               <asp:HyperLink
                ID="lnkGU"
                runat="server"
                NavigateUrl="~/GalleryUpload.aspx">

                Gallery Upload

                </asp:HyperLink>
             <asp:HyperLink
              ID="lnkStudentDetails"
              runat="server"
              NavigateUrl="~/StudentDetails.aspx">

              Registered Students Details

             </asp:HyperLink>


        </div>



        <!-- =====================================
             USER DROPDOWN
        ====================================== -->

        <div class="user-menu">


            <button
                type="button"
                class="user-button"
                onclick="toggleUserMenu()">


                <!-- User Initial -->

                <span class="user-avatar">

                    <asp:Label
                        ID="lblUserInitial"
                        runat="server"
                        Text="U">
                    </asp:Label>

                </span>



                <!-- User Name + Role -->

                <span class="user-details">


                    <span class="nav-user-name">

                        <asp:Label
                            ID="lblNavUserName"
                            runat="server"
                            Text="Account">
                        </asp:Label>

                    </span>


                    <span class="nav-user-role">

                        <asp:Label
                            ID="lblNavRole"
                            runat="server"
                            Text="User">
                        </asp:Label>

                    </span>


                </span>



                <span class="dropdown-arrow">
                    ▼
                </span>


            </button>



            <!-- =================================
                 DROPDOWN
            ================================== -->

            <div
                id="userDropdown"
                class="dropdown-menu">


                <!-- USER INFO -->

                <div class="dropdown-user">


                    <div class="dropdown-user-name">

                        <asp:Label
                            ID="lblDropdownName"
                            runat="server"
                            Text="User">
                        </asp:Label>

                    </div>


                    <div class="dropdown-role">

                        <asp:Label
                            ID="lblDropdownRole"
                            runat="server"
                            Text="Role">
                        </asp:Label>

                    </div>


                </div>



                <!-- LOGIN -->

                <asp:HyperLink
                    ID="lnkLogin"
                    runat="server"
                    NavigateUrl="~/AdminLogin.aspx">

                    Login Page

                </asp:HyperLink>



                <!-- LOGOUT -->

                <asp:Button
                    ID="btnLogout"
                    runat="server"
                    Text="Logout"
                    CssClass="logout-button"
                    OnClick="btnLogout_Click" />


            </div>


        </div>


    </nav>



    <!-- =========================================
         CHILD PAGE CONTENT
    ========================================== -->

    <main class="admin-content">


        <asp:ContentPlaceHolder
            ID="ContentPlaceHolder1"
            runat="server">
        </asp:ContentPlaceHolder>


    </main>


</form>



<script type="text/javascript">

    function toggleUserMenu() {

        var dropdown =
            document.getElementById(
                "userDropdown"
            );

        if (dropdown) {

            dropdown.classList.toggle(
                "show"
            );

        }

    }


    document.addEventListener(
        "click",
        function (event) {

            var userMenu =
                document.querySelector(
                    ".user-menu"
                );

            var dropdown =
                document.getElementById(
                    "userDropdown"
                );


            if (
                userMenu &&
                dropdown &&
                !userMenu.contains(event.target)
            ) {

                dropdown.classList.remove(
                    "show"
                );

            }

        }
    );

</script>


</body>

</html>