﻿<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="24.master.cs" Inherits="Success24v2._24" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
    <meta name="keywords" content="" />
    <meta name="description" content="" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

    <link href="lib/animate/animate.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="css/allcourses.css" rel="stylesheet">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="font-['Roboto'] bg-slate-50">
    <form id="form1" runat="server">
        <!-- Spinner -->
        <div id="spinner" class="show fixed inset-0 bg-white flex items-center justify-center z-[9999]">
            <div class="w-12 h-12 border-4 border-orange-500 border-t-transparent rounded-full animate-spin"></div>
        </div>

        <!-- Top Contact Bar -->
        <div class="bg-gradient-to-r from-orange-500 to-orange-600 text-white text-sm shadow-md py-3">
            <div class="max-w-7xl mx-auto px-6">
                <div class="flex flex-col md:flex-row items-center justify-between gap-3">
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-6">
                        <a href="#" class="flex items-center gap-2 hover:text-gray-200 transition-colors">
                            <i class="fas fa-map-marker-alt"></i>Find A Location
                        </a>
                        <a href="tel:+919555580458" class="flex items-center gap-2 hover:text-gray-200 transition-colors">
                            <i class="fas fa-phone-alt"></i>+91 9555580458
                        </a>
                        <a href="mailto:info@success24.in" class="flex items-center gap-2 hover:text-gray-200 transition-colors">
                            <i class="fas fa-envelope"></i>info@success24.in
                        </a>
                    </div>
                    <div class="flex items-center gap-3">
                        <a href="#" class="border border-white/30 w-8 h-8 rounded-full flex items-center justify-center hover:bg-white hover:text-orange-500 transition-all">
                            <i class="fab fa-facebook-f text-xs"></i>
                        </a>
                        <a href="#" class="border border-white/30 w-8 h-8 rounded-full flex items-center justify-center hover:bg-white hover:text-orange-500 transition-all">
                            <i class="fab fa-twitter text-xs"></i>
                        </a>
                        <a href="#" class="border border-white/30 w-8 h-8 rounded-full flex items-center justify-center hover:bg-white hover:text-orange-500 transition-all">
                            <i class="fab fa-instagram text-xs"></i>
                        </a>
                        <a href="#" class="border border-white/30 w-8 h-8 rounded-full flex items-center justify-center hover:bg-white hover:text-orange-500 transition-all">
                            <i class="fab fa-linkedin-in text-xs"></i>
                        </a>
                        <a href="#" class="border border-white/30 w-8 h-8 rounded-full flex items-center justify-center hover:bg-white hover:text-orange-500 transition-all">
                            <i class="fab fa-youtube text-xs"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="bg-white text-black sticky top-0 z-50 border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-6">

                <!-- NAV ROW -->
                <div class="relative flex items-center h-20">

                    <!-- Logo -->
                    <a href="/" class="flex items-center">
                        <img src="https://www.success24.in/img/logo1.png" class="h-10" />
                    </a>

                    <!-- Desktop Navigation (Your Original Center Style) -->
                    <ul class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center gap-10 font-semibold">
                        <asp:Literal ID="_LiteralNavDesktop" runat="server"></asp:Literal>
                    </ul>

                    <!-- Right Side -->
                    <div class="flex items-center ml-auto gap-4">

                        <!-- Search (Desktop Only) -->
                        <div class="hidden md:block relative">
                            <input type="text"
                                placeholder="Search..."
                                class="w-64 rounded-full border border-gray-300 px-5 py-2 text-sm focus:ring-2 focus:ring-orange-500 outline-none" />
                            <i class="fas fa-search absolute right-4 top-1/2 -translate-y-1/2 text-orange-400"></i>
                        </div>

                        <!-- Mobile Toggle -->
                        <button type="button"
                            id="mobileMenuButton"
                            class="md:hidden p-2 rounded hover:bg-gray-100">
                            <i class="fas fa-bars text-xl"></i>
                        </button>

                    </div>
                </div>
            </div>

            <!-- MOBILE MENU -->
            <div id="mobileMenu" class="hidden md:hidden bg-white border-t border-gray-200">
                <div class="px-6 py-6 space-y-6">

                    <!-- Mobile Search -->
                    <div class="relative">
                        <input type="text"
                            placeholder="Search..."
                            class="w-full rounded-full border border-gray-300 px-5 py-2 text-sm focus:ring-2 focus:ring-orange-500 outline-none" />
                        <i class="fas fa-search absolute right-4 top-1/2 -translate-y-1/2 text-orange-400"></i>
                    </div>

                    <!-- Mobile Navigation -->
                    <ul class="flex flex-col gap-4 font-semibold">
                        <asp:Literal ID="_LiteralNavMobile" runat="server"></asp:Literal>
                    </ul>

                </div>
            </div>
        </nav>


        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            <!-- Hero Section -->
            <section class="relative bg-gradient-to-r from-orange-500 via-orange-600 to-red-500 text-white py-20 overflow-hidden">
                <div class="absolute inset-0 opacity-20">
                    <div class="absolute top-0 left-0 w-96 h-96 bg-white rounded-full blur-3xl animate-pulse"></div>
                    <div class="absolute bottom-0 right-0 w-96 h-96 bg-pink-300 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
                </div>
                <div class="max-w-7xl mx-auto px-6 relative z-10">
                    <div class="grid md:grid-cols-2 gap-12 items-center">
                        <div class="scroll-fade-left">
                            <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">Transform Your Future With
                                <span class="block text-yellow-300">Quality Education</span>
                            </h1>
                            <p class="text-xl mb-8 text-white/90">Join Success24 and master the skills that matter. Expert trainers, hands-on projects, and career support await you.</p>
                            <div class="flex flex-wrap gap-4">
                                <a href="/courses" class="bg-white text-orange-600 px-8 py-4 rounded-full font-semibold hover:bg-yellow-300 hover:scale-105 transition-all shadow-lg">Explore Courses
                                </a>
                                <a href="/contact" class="border-2 border-white px-8 py-4 rounded-full font-semibold hover:bg-white hover:text-orange-600 transition-all">Get Started
                                </a>
                            </div>
                        </div>
                        <div class="scroll-fade-right">
                            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800" alt="Students Learning" class="rounded-2xl shadow-2xl hover-lift" />
                        </div>
                    </div>
                </div>
            </section>

            <!-- Stats Section -->
            <section class="py-16 bg-slate-900 text-white">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                        <div class="scroll-scale">
                            <div class="text-5xl font-bold text-orange-500 mb-2 counter" data-target="5000">0</div>
                            <p class="text-gray-300">Students Trained</p>
                        </div>
                        <div class="scroll-scale">
                            <div class="text-5xl font-bold text-orange-500 mb-2 counter" data-target="50">0</div>
                            <p class="text-gray-300">Expert Trainers</p>
                        </div>
                        <div class="scroll-scale">
                            <div class="text-5xl font-bold text-orange-500 mb-2 counter" data-target="100">0</div>
                            <p class="text-gray-300">Courses Available</p>
                        </div>
                        <div class="scroll-scale">
                            <div class="text-5xl font-bold text-orange-500 mb-2 counter" data-target="98">0</div>
                            <p class="text-gray-300">Success Rate %</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Featured Courses -->
            <section class="py-20 bg-slate-50">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="text-center mb-16 scroll-reveal">
                        <h2 class="text-4xl font-bold text-gray-900 mb-4">Popular Courses</h2>
                        <p class="text-xl text-gray-600">Master in-demand skills with our comprehensive training programs</p>
                    </div>
                    <div class="grid md:grid-cols-3 gap-8">
                        <!-- Course Card 1 -->
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover-lift scroll-reveal">
                            <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600" alt="Web Development" class="w-full h-48 object-cover" />
                            <div class="p-6">
                                <span class="bg-orange-100 text-orange-600 px-3 py-1 rounded-full text-sm font-semibold">Development</span>
                                <h3 class="text-2xl font-bold mt-4 mb-3">Full Stack Web Development</h3>
                                <p class="text-gray-600 mb-4">Master HTML, CSS, JavaScript, React, Node.js and build real-world projects.</p>
                                <div class="flex items-center justify-between">
                                    <span class="text-orange-600 font-bold text-xl">₹25,000</span>
                                    <a href="/courses/web-dev" class="bg-orange-500 text-white px-6 py-2 rounded-full hover:bg-orange-600 transition-colors">Enroll Now
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Course Card 2 -->
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover-lift scroll-reveal">
                            <img src="https://images.unsplash.com/photo-1555949963-aa79dcee981c?w=600" alt="Data Science" class="w-full h-48 object-cover" />
                            <div class="p-6">
                                <span class="bg-blue-100 text-blue-600 px-3 py-1 rounded-full text-sm font-semibold">Data Science</span>
                                <h3 class="text-2xl font-bold mt-4 mb-3">Data Science & Analytics</h3>
                                <p class="text-gray-600 mb-4">Learn Python, Machine Learning, Data Visualization and AI fundamentals.</p>
                                <div class="flex items-center justify-between">
                                    <span class="text-orange-600 font-bold text-xl">₹30,000</span>
                                    <a href="/courses/data-science" class="bg-orange-500 text-white px-6 py-2 rounded-full hover:bg-orange-600 transition-colors">Enroll Now
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Course Card 3 -->
                        <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover-lift scroll-reveal">
                            <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600" alt="Digital Marketing" class="w-full h-48 object-cover" />
                            <div class="p-6">
                                <span class="bg-green-100 text-green-600 px-3 py-1 rounded-full text-sm font-semibold">Marketing</span>
                                <h3 class="text-2xl font-bold mt-4 mb-3">Digital Marketing Mastery</h3>
                                <p class="text-gray-600 mb-4">Master SEO, Social Media, PPC, Content Marketing and Analytics.</p>
                                <div class="flex items-center justify-between">
                                    <span class="text-orange-600 font-bold text-xl">₹20,000</span>
                                    <a href="/courses/digital-marketing" class="bg-orange-500 text-white px-6 py-2 rounded-full hover:bg-orange-600 transition-colors">Enroll Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


        </asp:ContentPlaceHolder>

        <footer class="bg-slate-900 text-gray-300 pt-16">
            <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-10 pb-12">

                <div>
                    <a href="/" class="flex items-center gap-3">
                        <img
                            src="img/logo1.png"
                            alt="Success24 Logo"
                            class="h-10 w-auto" />
                    </a>
                    <p class="text-white/80 font-medium mb-4">A New Way To Success Together</p>
                    <p class="text-sm leading-relaxed">
                        Success24 is committed to delivering quality education and professional training to empower the next generation of tech leaders.
                    </p>
                    <div class="flex gap-4 mt-6 text-lg">
                        <a href="#" class="hover:text-orange-500 transition"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="hover:text-orange-500 transition"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="hover:text-orange-500 transition"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="hover:text-orange-500 transition"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>

                <div>
                    <h3 class="text-white font-semibold mb-6 text-xl">Address</h3>
                    <div class="space-y-4 text-sm">
                        <p class="flex items-start gap-3">
                            <i class="fas fa-map-marker-alt text-orange-500 mt-1"></i>
                            D1/338, New Kondli, Delhi – 110096
                        </p>
                        <p class="flex items-center gap-3">
                            <i class="fa fa-phone text-orange-500"></i>
                            +91 9555580458
                        </p>
                        <p class="flex items-center gap-3">
                            <i class="fa fa-envelope text-orange-500"></i>
                            info@success24.in
                        </p>
                    </div>
                </div>

                <div class="xl:col-span-2">
                    <div class="bg-white rounded-md overflow-hidden shadow-lg text-slate-800 max-w-lg mx-auto xl:mx-0">
                        <table class="w-full border-collapse text-xs sm:text-sm">
                            <tr class="bg-gray-100 cursor-pointer">
                                <td id="tab-testimonials" onclick="switchTab('testimonials')"
                                    class="w-1/3 py-2 px-2 text-center font-bold bg-orange-500 text-white transition-all">
                                    <i class="fas fa-tag mr-1"></i>Testimonials
                                </td>
                                <td id="tab-linked" onclick="switchTab('linked')"
                                    class="w-1/3 py-2 px-2 text-center font-bold hover:bg-gray-200 border-x border-gray-200 transition-all">
                                    <i class="fas fa-link mr-1"></i>Linked Sites
                                </td>
                                <td id="tab-location" onclick="switchTab('location')"
                                    class="w-1/3 py-2 px-2 text-center font-bold hover:bg-gray-200 transition-all">
                                    <i class="fas fa-map-marker-alt mr-1"></i>Location
                                </td>
                            </tr>
                        </table>

                        <!-- Fixed-height content area so every tab shows same size -->
                        <!-- Adjust h-44 -> h-56 if you want taller -->
                        <div class="p-5 h-44">
                            <div id="content-testimonials" class="tab-pane block h-full flex flex-col">
                                <div class="flex justify-between items-center mb-3">
                                    <div>
                                        <h4 class="text-lg font-bold text-slate-800">Ashish Bhardwaj</h4>
                                        <p class="text-gray-500 italic text-xs">Greater London, United Kingdom﻿</p>
                                    </div>
                                    <img src="https://ui-avatars.com/api/?name=Ashish+Bhardwaj&background=f97316&color=fff" alt="User" class="w-10 h-10 rounded-full shadow-sm">
                                </div>
                                <div class="text-gray-600 text-sm leading-snug overflow-auto">
                                    SharePoint Development Training Conducted very well.
                                </div>
                            </div>

                            <div id="content-linked" class="tab-pane hidden h-full overflow-auto">
                                <ul class="space-y-2 text-sm">
                                    <li><a href="#" class="text-orange-500 hover:underline flex items-center gap-2">Course Catalog</a></li>
                                    <li><a href="#" class="text-orange-500 hover:underline flex items-center gap-2">Student Login</a></li>
                                    <li><a href="#" class="text-orange-500 hover:underline flex items-center gap-2">Certification Portal</a></li>
                                </ul>
                            </div>

                            <!-- Replace the Location tab content area with this markup (keeps fixed height and shows inline horizontal scroll list) -->
                            <div id="content-location" class="tab-pane hidden text-sm h-full flex flex-col" role="region" aria-labelledby="tab-location">

                                <!-- Horizontal scroll single-line list; stays inside fixed-height tab -->
                                <div class="overflow-x-auto whitespace-nowrap py-2">
                                    <asp:Literal runat="server" ID="_LiteralLocationAll"></asp:Literal>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="mt-6 max-w-lg mx-auto xl:mx-0">
                        <p class="text-white font-medium text-sm mb-2">Send us an Email</p>
                        <div class="flex overflow-hidden rounded">
                            <input type="email" placeholder="Email address"
                                class="flex-1 px-3 py-2 text-sm text-slate-900 focus:outline-none">
                            <button class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2 text-sm font-bold transition">
                                SEND
                            </button>
                        </div>
                    </div>
                </div>

            </div>

            <div class="border-t border-slate-800 bg-slate-950 text-center py-4 text-sm text-gray-400">
                © 2025 Success24 | Designed By Teceon Software Private Limited
            </div>
        </footer>
        <a href="#" class="fixed bottom-6 right-6 bg-orange-500 text-white p-3 rounded-full animate-bounce-slow hover:bg-orange-600 transition-colors z-50">
            <i class="fa fa-arrow-up"></i>
        </a>
    </form>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://success24.in/lib/wow/wow.min.js"></script>
    <script src="https://success24.in/lib/easing/easing.min.js"></script>
    <script src="https://success24.in/lib/waypoints/waypoints.min.js"></script>
    <script src="https://success24.in/lib/counterup/counterup.min.js"></script>
    <script src="https://success24.in/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="https://success24.in/lib/lightbox/js/lightbox.min.js"></script>
    <script src="https://success24.in/js/main.js"></script>
    <script>
        function switchTab(tabId) {
            const panes = document.querySelectorAll('.tab-pane');
            panes.forEach(p => p.classList.replace('block', 'hidden'));

            const tabs = [document.getElementById('tab-testimonials'), document.getElementById('tab-linked'), document.getElementById('tab-location')];
            tabs.forEach(t => {
                t.classList.remove('bg-orange-500', 'text-white');
                t.classList.add('hover:bg-gray-200', 'text-slate-800');
            });

            document.getElementById('content-' + tabId).classList.replace('hidden', 'block');
            const activeTab = document.getElementById('tab-' + tabId);
            activeTab.classList.add('bg-orange-500', 'text-white');
            activeTab.classList.remove('hover:bg-gray-200', 'text-slate-800');
        }
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var btn = document.getElementById("mobileMenuButton");
            var menu = document.getElementById("mobileMenu");

            if (btn && menu) {
                btn.addEventListener("click", function (e) {
                    e.preventDefault(); // extra safety
                    menu.classList.toggle("hidden");
                });
            }
        });
    </script>



    <script src="js/main.js"></script>
</body>
</html>
